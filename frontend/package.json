{
  "name": "sub2api-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:seo": "node scripts/generate-seo-assets.mjs",
    "docs:check": "python3 ../scripts/client_matrix_catalog.py check && python3 ../scripts/model_doc_catalog.py check && python3 ../scripts/model_doc_matrix.py audit --contracts ../model-doc-contracts --client-matrix ../model-doc-contracts/client-matrix.json --pricing-url http://127.0.0.1:4178/api/v1/public/model-pricing && node scripts/check-docs-content.mjs",
    "build": "node scripts/generate-seo-assets.mjs && vue-tsc -b && vite build && node scripts/check-admin-matrix-public-boundary.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "bundle:check:test": "node --test scripts/check-bundle-budget.test.mjs",
    "admin-matrix-boundary:test": "node --test scripts/check-admin-matrix-public-boundary.test.mjs",
    "boundary:check": "node scripts/check-frontend-boundaries.mjs"
  },
  "dependencies": {
    "@lobehub/icons": "^4.0.2",
    "@stripe/stripe-js": "^9.0.1",
    "@tanstack/vue-virtual": "^3.13.23",
    "@vueuse/core": "^10.7.0",
    "axios": "^1.16.0",
    "chart.js": "^4.4.1",
    "dompurify": "^3.4.14",
    "driver.js": "^1.4.0",
    "html-to-image": "1.11.13",
    "marked": "^17.0.1",
    "md-editor-v3": "^6.4.2",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "vue": "^3.4.0",
    "vue-chartjs": "^5.3.0",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.2.5",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20.10.5",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.25.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.6.0",
    "vite": "^5.0.10",
    "vite-plugin-checker": "^0.9.1",
    "vitest": "^2.1.9",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
