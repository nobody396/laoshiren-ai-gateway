  },
  "gap_expansion_contract": {
    "public_model_source": "Read the public_model matrix and its model contracts; this client matrix never copies model, group, or price rows.",
    "candidate_rule": "For every public model, intersect its verified model_protocol cells with client_protocol.support=supported, then expand every exact client release version_key and documented OS.",
    "cell_key": [
      "model_id",
      "model_contract_fingerprint",
      "protocol",
      "client_id",
      "client_version_key",
      "os"
    ],
    "evidence_reuse_match": [
      "model_id",
      "model_contract_fingerprint",
      "protocol",
      "client_id",
      "client_version_key",
      "os",
      "client_protocol_fingerprint",
      "client_reasoning_fingerprint",
      "client_config_os_fingerprint"
    ],
    "reuse_rule": "Reuse only a terminal evidence record whose match fields are byte-for-byte equal and whose artifact digest still resolves. A version range or same client on another OS is not a match.",
    "invalidation": [
      "client release version_key changed",
      "OS changed",
      "native protocol or client transport feature changed",
      "reasoning control, persistence, or fallback changed",
      "owned fields, merge, backup, idempotency, or verification command changed",
      "model contract fingerprint changed"
    ],
    "new_client_completion": "Every expanded cell is terminal verified or unsupported; blocked and unverified remain release gaps."
  },
